{
  "name": "emmm1e3m-github-pages",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "vite --config AllForSUXINHAO/TravellingBingo/vite.config.ts",
    "build": "vite build --config AllForSUXINHAO/TravellingBingo/vite.config.ts",
    "preview": "vite preview --config AllForSUXINHAO/TravellingBingo/vite.config.ts",
    "typecheck": "tsc --project AllForSUXINHAO/TravellingBingo/tsconfig.json --noEmit",
    "lint": "eslint AllForSUXINHAO/TravellingBingo/src scripts",
    "test": "vitest run --config AllForSUXINHAO/TravellingBingo/vite.config.ts",
    "test:video-catalog": "node --test scripts/research/bilibili-video-catalog.test.mjs",
    "test:favourites": "node --test scripts/research/bilibili-favourites.test.mjs",
    "test:watch": "vitest --config AllForSUXINHAO/TravellingBingo/vite.config.ts",
    "test:e2e": "playwright test --config AllForSUXINHAO/TravellingBingo/playwright.config.ts",
    "test:miracle-assets": "node --test scripts/assets/build-miracle-assets.test.mjs",
    "format": "prettier --write \"AllForSUXINHAO/TravellingBingo/**/*.{ts,tsx,css,html,json}\" \"scripts/**/*.mjs\" package.json",
    "format:check": "prettier --check \"AllForSUXINHAO/TravellingBingo/**/*.{ts,tsx,css,html,json}\" \"scripts/**/*.mjs\" package.json",
    "assets:download": "node scripts/assets/download-million-posters.mjs",
    "assets:download:site-firsts": "node scripts/assets/download-site-first-covers.mjs",
    "assets:build": "node scripts/assets/build-web-assets.mjs",
    "assets:build:site-firsts": "node scripts/assets/build-site-first-assets.mjs",
    "assets:build:demo": "node scripts/assets/build-demo-visuals.mjs",
    "assets:build:friends": "node scripts/assets/build-friend-assets.mjs",
    "assets:build:miracle": "node scripts/assets/build-miracle-assets.mjs",
    "assets:build:fonts": "node scripts/assets/build-fonts.mjs",
    "assets:build:postcards": "node scripts/assets/build-demo-postcards.mjs",
    "assets:build:video-catalog": "node scripts/research/sync-bilibili-video-catalog.mjs",
    "assets:verify": "node scripts/assets/verify-assets.mjs",
    "site:assemble": "node scripts/site/assemble-site.mjs",
    "site:verify": "node scripts/site/verify-site.mjs",
    "research:sync:postcards": "node scripts/research/sync-postcard-catalog.mjs",
    "research:sync:bilibili": "node scripts/research/sync-bilibili-video-catalog.mjs --refresh",
    "research:sync:favourites": "node scripts/research/sync-bilibili-favourites.mjs --refresh",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run test:video-catalog && npm run test:favourites && npm run test:miracle-assets && npm run assets:verify"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.9.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "sharp": "^0.35.3",
    "subset-font": "^2.5.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
